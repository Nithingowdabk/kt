# Enable URL Rewriting
<IfModule mod_rewrite.c>
RewriteEngine On

# Disable Directory Browsing
Options -Indexes

# 0. XML Sitemap & Robots routing
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 1. Route Clean Trek Details: /treks/slug-name -> /treks/details.php?slug=slug-name
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^treks/([a-zA-Z0-9_-]+)/?$ treks/details.php?slug=$1 [QSA,L]

# 2. Route Clean Trek Listing: /treks -> /treks/index.php
RewriteRule ^treks/?$ treks/index.php [QSA,L]

# 3. Route Clean Category: /category/slug-name -> /treks/category.php?slug=slug-name
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^category/([a-zA-Z0-9_-]+)/?$ treks/category.php?slug=$1 [QSA,L]

# 4. Route Clean Blog Article: /blogs/slug-name -> /blogs.php?slug=slug-name
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blogs/([a-zA-Z0-9_-]+)/?$ blogs.php?slug=$1 [QSA,L]

# 5. Route general clean URLs to their .php files (e.g. /about -> /about.php, /contact -> /contact.php, /user/dashboard -> /user/dashboard.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [QSA,L]

</IfModule>

# MIME Types for Modern Web Formats
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# Gzip Compression (mod_deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Leverage Browser Caching (mod_expires & mod_headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Images
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # 1 Year Cache for Static Images, Fonts, CSS, JS
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|avif|js|css|swf|woff2|woff|ttf|svg)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # Short-lived cache for HTML/PHP pages (10 minutes browser cache, must revalidate)
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "public, max-age=600, must-revalidate"
    </FilesMatch>


    # Vary header for proper CDN/proxy caching
    Header append Vary Accept-Encoding

    # Security: X-Content-Type-Options to prevent MIME sniffing
    Header set X-Content-Type-Options "nosniff"

    # CORS for fonts loaded from CDNs
    <FilesMatch "\.(woff2|woff|ttf|eot|svg)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# Enable ETag (helps with conditional requests / 304 responses)
FileETag MTime Size
